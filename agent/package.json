{
  "name": "system-pulse",
  "productName": "SystemPulse",
  "version": "0.0.5",
  "private": true,
  "description": "System tray application for get user system information",
  "main": "dist/main/main.js",
  "scripts": {
  "start": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently \"vite --config vite.renderer.config.mts\" \"wait-on http://localhost:5173 && electron .\"",
  "package": "electron-forge package",
  "make": "electron-forge make",
  "build:vite": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts && vite build --config vite.renderer.config.mts",
  "build": "yarn build:vite",
  "publish": "yarn build && electron-builder --publish always"
},
  "repository": "https://github.com/kaiobrunobm/support-app",
  "build": {
    "appId": "com.systempulse.agent",
    "productName": "SystemPulse",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "directories": {
    "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kaiobrunobm",
        "repo": "support-app"
      }
    ]
  },
  "keywords": [],
  "author": {
    "name": "Kaio Bruno",
    "email": "bmkaiobruno@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-wix": "^7.9.0",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.3",
    "@electron-forge/plugin-fuses": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron/fuses": "^1.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/speedtest-net": "^2.1.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "electron": "37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.6",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "3",
    "typescript": "~4.5.4",
    "vite": "^5.4.19",
    "vite-plugin-static-copy": "^3.1.1",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@electron-forge/publisher-github": "^7.8.3",
    "@headlessui/react": "^2.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.540.0",
    "motion": "^12.23.12",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-easy-crop": "^5.5.2",
    "react-imask": "^7.6.1",
    "react-router": "^7.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "systeminformation": "^5.27.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
